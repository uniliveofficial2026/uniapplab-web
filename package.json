    "test:asset-url-resolution": "node scripts/visual-runtime/test-asset-url-resolution.mjs",
    "test:production-assets": "node scripts/visual-runtime/test-production-assets.mjs",
    "test:image-decode": "node scripts/visual-runtime/test-image-decode.mjs",
    "test:animation-runtime": "node scripts/visual-runtime/test-animation-runtime.mjs",
    "test:ios-animation-contracts": "node scripts/visual-runtime/test-ios-animation-contracts.mjs",
    "test:asset-cache-integrity": "node scripts/visual-runtime/test-asset-cache-integrity.mjs",
    "test:dynamic-media-url": "node scripts/visual-runtime/test-dynamic-media-url.mjs",
