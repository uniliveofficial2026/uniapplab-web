{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "postinstall": "node scripts/ensure-live.mjs",
    "setup": "bash scripts/ensure-pnpm.sh && node scripts/ensure-live.mjs",
    "build": "pnpm -r --filter \"./artifacts/instacollab\" --filter \"./artifacts/api-server\" --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:stage-b": "node scripts/test-stage-b.mjs",
    "test:stage-c": "node scripts/test-stage-c.mjs",
    "test:stage-c:pack": "node scripts/stage-c-pack-validate.mjs",
    "dev": "node scripts/live-sync.mjs",
    "dev:app": "pnpm --filter @workspace/instacollab run dev",
    "dev:light": "LIVE_SYNC_DEPLOY=0 UX_AGENT=0 pnpm --filter @workspace/instacollab run dev",
    "dev:instacollab": "pnpm --filter @workspace/instacollab run dev",
    "develop": "node scripts/live-sync.mjs",
    "live": "node scripts/live-sync.mjs",
    "ensure:live": "node scripts/ensure-live.mjs",
    "dev:mobile": "pnpm --filter @workspace/instacollab run dev:mobile",
    "mobile:preview": "pnpm --filter @workspace/instacollab run mobile:preview",
    "mobile:live": "pnpm --filter @workspace/instacollab run mobile:live",
    "auth:bootstrap-db": "pnpm --filter @workspace/instacollab run auth:bootstrap-db",
    "auth:repair-policies": "pnpm --filter @workspace/instacollab run auth:repair-policies",
    "auth:repair-follows": "pnpm --filter @workspace/instacollab run auth:repair-follows",
    "auth:apply-sql": "node scripts/apply-supabase-sql.mjs",
    "auth:repair-supabase": "pnpm --filter @workspace/instacollab run auth:repair-supabase",
    "auth:check": "pnpm --filter @workspace/instacollab run auth:check",
    "auth:check:prod": "pnpm --filter @workspace/instacollab run auth:check:prod",
    "oauth:setup": "pnpm --filter @workspace/instacollab run oauth:setup",
    "email-otp:setup": "pnpm --filter @workspace/instacollab run email-otp:setup",
    "email-otp:apply-template": "pnpm --filter @workspace/instacollab run email-otp:apply-template",
    "resend:test": "pnpm --filter @workspace/instacollab run resend:test",
    "email:setup": "pnpm --filter @workspace/instacollab run email:setup",
    "domains:setup": "node scripts/print-domains-setup.mjs",
    "stack:setup": "node scripts/print-stack-setup.mjs",
    "codespace:setup": "node scripts/print-codespace-setup.mjs",
    "fly:setup": "node scripts/print-fly-setup.mjs",
    "fly:check": "node scripts/check-fly.mjs",
    "fly:env-secrets": "node scripts/sync-fly-secrets.mjs",
    "fly:deploy": "bash scripts/fly-deploy.sh",
    "linear:setup": "node scripts/print-linear-setup.mjs",
    "linear:check": "node scripts/check-linear.mjs",
    "linear:env-vercel": "node scripts/sync-linear-vercel-env.mjs",
    "stack:verify": "node scripts/verify-production.mjs && node scripts/check-upstash.mjs -- --prod && pnpm --filter @workspace/instacollab run livekit:check -- --prod && node scripts/check-linear.mjs -- --prod",
    "github:protect-main": "bash scripts/protect-github-main.sh",
    "git:push": "bash scripts/github-push.sh",
    "git:clean-history": "bash scripts/reset-clean-main.sh --yes",
    "deploy:vercel": "bash scripts/vercel-deploy.sh --prod",
    "deploy:vercel:git": "bash scripts/vercel-deploy-git.sh",
    "deploy:vercel:cli": "bash scripts/vercel-deploy.sh --prod",
    "deploy:vercel:fast": "bash scripts/vercel-deploy.sh --prod",
    "deploy:vercel:full": "LIVE_SYNC_FULL_REPO=1 bash scripts/vercel-deploy.sh --prod",
    "heal": "node scripts/self-heal.mjs",
    "fix": "node scripts/auto-fix.mjs",
    "verify:prod": "node scripts/verify-production.mjs",
    "check:health": "node artifacts/instacollab/scripts/check-health.mjs",
    "ux:agent": "node scripts/background-ux-agent.mjs",
    "ux:learn": "node scripts/ux-learning-engine.mjs",
    "ux:gemini": "node scripts/ux-gemini-fix.mjs",
    "handoff": "node scripts/app-handoff.mjs",
    "handoff:cycle": "node scripts/app-handoff.mjs cycle",
    "autopilot": "node scripts/autopilot.mjs",
    "upstash:setup": "node scripts/print-upstash-setup.mjs",
    "upstash:check": "node scripts/check-upstash.mjs",
    "upstash:env-vercel": "node scripts/sync-upstash-vercel-env.mjs",
    "upstash:schedule": "node scripts/setup-qstash-schedule.mjs",
    "livekit:setup": "pnpm --filter @workspace/instacollab run livekit:setup",
    "livekit:check": "pnpm --filter @workspace/instacollab run livekit:check",
    "livekit:env-vercel": "pnpm --filter @workspace/instacollab run livekit:env-vercel",
    "r2:env-vercel": "node scripts/sync-r2-vercel-env.mjs",
    "playwright:install": "pnpm --filter @workspace/instacollab run playwright:install",
    "smoke:manage-tab": "pnpm --filter @workspace/instacollab run smoke:manage-tab",
    "ai:install": "pnpm --filter @workspace/api-server add ai @ai-sdk/google",
    "vercel:fix-root": "node scripts/fix-vercel-project-root.mjs",
    "vercel:fix-settings": "node scripts/sync-vercel-project-settings.mjs",
    "vercel:redeploy-git": "node scripts/vercel-redeploy-git.mjs",
    "vercel:deploy-api": "bash scripts/vercel-deploy-api.sh",
    "vercel:open-settings": "bash scripts/open-vercel-api-settings.sh",
    "asset-studio:doctor": "pnpm --filter @workspace/unilives-asset-studio run doctor",
    "asset-studio:status": "pnpm --filter @workspace/unilives-asset-studio run status",
    "asset-studio:prepare": "pnpm --filter @workspace/unilives-asset-studio exec tsx src/cli/prepare.ts",
    "asset-studio:preview": "pnpm --filter @workspace/unilives-asset-studio exec tsx src/cli/preview.ts",
    "asset-studio:approve": "pnpm --filter @workspace/unilives-asset-studio exec tsx src/cli/approve.ts",
    "asset-studio:validate": "pnpm --filter @workspace/unilives-asset-studio run validate",
    "android:bundle": "pnpm --filter @workspace/instacollab run android:bundle",
    "android:bundle:offline": "pnpm --filter @workspace/instacollab run android:bundle:offline"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@rollup/rollup-darwin-arm64": "4.60.3",
    "@tailwindcss/oxide-darwin-arm64": "4.1.14",
    "lightningcss-darwin-arm64": "1.32.0"
  }
}
