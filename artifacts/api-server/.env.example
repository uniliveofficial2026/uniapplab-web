SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated usernames auto-promoted to admin on GET /api/me
PLATFORM_ADMIN_USERNAMES=uniliveofficial2026,oowai20
# Optional comma-separated emails also auto-promoted
PLATFORM_ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:5173,https://app.uniapplab.com
PORT=3000
# YouTube Data API — prefer videos.list for browse; search.list burns 100 units/call.
YOUTUBE_API_KEY=
# Optional comma-separated rotation when one project hits Search Queries quota
YOUTUBE_API_KEYS=

# Cloudflare R2 — product images/videos (binaries NOT in Supabase Storage)
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=uniapplab-media
R2_REGION=auto
# Public CDN (r2.dev or custom domain)
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
# Cloudflare Worker with R2 binding (preferred upload lane)
MEDIA_WORKER_URL=https://uniapplab-media.<subdomain>.workers.dev

# Optional legacy S3 keys (not required when using MEDIA_WORKER_URL)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Discord Interactions (Developer Portal → Application → Public Key)
# Endpoint: https://app.uniapplab.com/api/discord/interactions
DISCORD_PUBLIC_KEY=

# Platform architecture (canonical):
# Auth/DB/Realtime = Supabase | Media = Cloudflare R2 + CDN Worker
# Frontend = Vercel | Backend = Supabase Edge Functions (+ Workers for media)
# MongoDB Atlas + Amazon Aurora are Marketplace extras — NOT app data stores.
