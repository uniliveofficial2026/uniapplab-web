rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthed() {
      return request.auth != null;
    }

    // Firebase backup lane: profiles keyed by Supabase UUID when custom claim is set.
    function ownsCloudUser(userId) {
      return isAuthed() && (
        request.auth.uid == userId ||
        request.auth.token.supabase_uid == userId
      );
    }

    function safeProfileData(data) {
      return data.keys().hasAll(['id', 'username', 'display_name'])
        && data.id == resource.id
        && data.username is string
        && data.username.size() >= 3
        && data.username.size() <= 32
        && data.display_name is string
        && data.display_name.size() <= 80
        && (!('role' in data))
        && (!('banned_at' in data))
        && (!('ban_reason' in data));
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create: if ownsCloudUser(userId) && safeProfileData(request.resource.data);
      allow update: if ownsCloudUser(userId)
        && safeProfileData(request.resource.data)
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    function profileIdForAuth() {
      return request.auth.token.supabase_uid != null
        ? request.auth.token.supabase_uid
        : request.auth.uid;
    }

    function isPlatformAdmin() {
      return isAuthed()
        && exists(/databases/$(database)/documents/profiles/$(profileIdForAuth()))
        && get(/databases/$(database)/documents/profiles/$(profileIdForAuth())).data.get('role', '') == 'admin';
    }

    match /platform_app_brand/{docId} {
      allow read: if true;
      allow create, update: if docId == 'default' && isPlatformAdmin();
      allow delete: if false;
    }

    match /platform_gift_catalog/{docId} {
      allow read: if true;
      allow create, update: if docId == 'default' && isPlatformAdmin();
      allow delete: if false;
    }

    // Gift economy dual-lane (mirrors Supabase wallets / gift_transactions).
    match /wallets/{userId} {
      allow read: if isAuthed();
      allow create: if ownsCloudUser(userId);
      // Cross-user updates required for gift settle (sender debit + receiver diamonds).
      allow update: if isAuthed();
      allow delete: if false;
    }

    match /gift_transactions/{txId} {
      allow read: if isAuthed() && (
        resource.data.sender_id == profileIdForAuth()
        || resource.data.receiver_id == profileIdForAuth()
        || isPlatformAdmin()
      );
      allow create: if isAuthed()
        && request.resource.data.sender_id == profileIdForAuth();
      allow update, delete: if false;
    }

    match /gift_room_stats/{statId} {
      allow read: if isAuthed();
      allow create, update: if isAuthed();
      allow delete: if false;
    }

    match /user_app_state/{userId} {
      allow read, create, update: if ownsCloudUser(userId);
      allow delete: if false;
    }
  }
}
