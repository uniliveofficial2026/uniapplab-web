{
  "name": "@workspace/instacollab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "greedy-tap:dev": "node scripts/greedy-tap-dev.mjs",
    "greedy-tap:build": "node scripts/build-greedy-tap-production.mjs",
    "greedy-tap:smoke": "node scripts/smoke-greedy-tap.mjs",
    "dev:mobile": "node scripts/free-port.mjs 5173; DEV_BIND_HOST=0.0.0.0 vite --config vite.config.ts --host 0.0.0.0",
    "dev:mobile:https": "node scripts/free-port.mjs 4173 && PORT=4173 DEV_HTTPS=true vite --config vite.config.ts --host 0.0.0.0",
    "dev:https": "DEV_HTTPS=true vite --config vite.config.ts --host 0.0.0.0",
    "dev:pwa": "VITE_PWA_DEV=true PWA_DEV=true vite --config vite.config.ts --host 0.0.0.0",
    "dev:pwa:https": "VITE_PWA_DEV=true DEV_HTTPS=true PWA_DEV=true vite --config vite.config.ts --host 0.0.0.0",
    "build": "node scripts/sync-ar-assets.mjs && node scripts/write-public-supabase-config.mjs && node scripts/write-public-firebase-config.mjs && node scripts/assert-vite-env.mjs && node scripts/sync-greedy-tap-static.mjs && node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js build --config vite.config.ts && node ../../scripts/write-live-version.mjs build",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "serve:https": "node scripts/free-port.mjs 4173 && DEV_HTTPS=true vite preview --config vite.config.ts --host 0.0.0.0",
    "mobile:preview": "pnpm run build && node scripts/free-port.mjs 4173 && DEV_HTTPS=true vite preview --config vite.config.ts --host 0.0.0.0",
    "mobile:live": "node scripts/free-port.mjs 4173 && PORT=4173 DEV_HTTPS=true VITE_PWA_DEV=true PWA_DEV=true vite --config vite.config.ts --host 0.0.0.0",
    "cap:sync": "pnpm run build && pnpm exec cap sync && node scripts/pin-android-toolchain.mjs",
    "cap:icons": "node scripts/generate-native-icons.mjs",
    "cap:ios": "pnpm run cap:sync && pnpm exec cap open ios",
    "cap:android": "pnpm run cap:sync && pnpm exec cap open android",
    "cap:sync:live": "CAP_SERVER_URL=https://app.uniapplab.com pnpm exec cap sync && node scripts/pin-android-toolchain.mjs",
    "android:pin-toolchain": "node scripts/pin-android-toolchain.mjs",
    "android:bundle": "bash scripts/android-bundle.sh",
    "android:bundle:offline": "bash scripts/android-bundle.sh --offline",
    "android:bundle:gradle": "bash scripts/android-bundle.sh --skip-sync",
    "android:apk": "bash scripts/android-apk.sh",
    "android:apk:live": "bash scripts/android-apk.sh --live",
    "ios:ipa": "bash scripts/ios-ipa.sh",
    "ios:ipa:live": "bash scripts/ios-ipa.sh --live",
    "start": "pnpm run build && pnpm run serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "unilives:validate-manifest": "node scripts/validate-unilives-manifest.mjs",
    "unilives:validate-registry": "node scripts/validate-unilives-registry.mjs",
    "unilives:validate": "pnpm run unilives:validate-manifest && pnpm run unilives:validate-registry",
    "auth:bootstrap-db": "node scripts/build-bootstrap-full.mjs && node scripts/auth-bootstrap-db.mjs",
    "auth:bootstrap-full": "node scripts/build-bootstrap-full.mjs",
    "auth:repair-policies": "node scripts/auth-repair-policies.mjs",
    "auth:repair-follows": "node scripts/auth-repair-follows.mjs",
    "auth:apply-sql": "node scripts/apply-supabase-sql.mjs",
    "auth:repair-supabase": "node scripts/repair-supabase-remote.mjs",
    "auth:check": "node scripts/check-cloud-auth.mjs",
    "auth:check:prod": "node scripts/check-production-auth.mjs",
    "oauth:setup": "node scripts/print-oauth-setup.mjs",
    "oauth:verify-domain": "node scripts/verify-google-domain.mjs",
    "webar:domain": "node scripts/print-webar-domain.mjs",
    "email-otp:setup": "node scripts/print-email-otp-setup.mjs",
    "email-otp:apply-template": "node scripts/apply-email-otp-template.mjs",
    "resend:test": "node scripts/send-test-email.mjs",
    "email:setup": "node scripts/setup-resend-email.mjs",
    "deepar:setup": "node scripts/print-deepar-setup.mjs",
    "deepar:install": "node scripts/install-deepar-assets.mjs",
    "deepar:previews": "node scripts/render-deepar-sdk-previews.mjs && node scripts/extract-deepar-previews.mjs",
    "deepar:env-vercel": "node scripts/sync-deepar-vercel-env.mjs",
    "deepar:sync": "node scripts/sync-deepar-assets.mjs",
    "ar:sync": "node scripts/sync-ar-assets.mjs",
    "trtc:install": "node scripts/install-trtc-webar-assets.mjs",
    "livekit:setup": "node scripts/print-livekit-setup.mjs",
    "livekit:check": "node scripts/check-livekit.mjs",
    "livekit:env-vercel": "node scripts/sync-livekit-vercel-env.mjs",
    "smoke:manage-tab": "node scripts/smoke-manage-tab.mjs",
    "smoke:full-app": "node scripts/smoke-full-app.mjs",
    "smoke:platform": "node scripts/smoke-platform-runtime.mjs",
    "playwright:install": "node scripts/install-playwright-browsers.mjs",
    "check:health": "node scripts/check-health.mjs",
    "posts:bootstrap-db": "node scripts/posts-bootstrap-db.mjs",
    "test:reels": "node scripts/test-reels-playback.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@deepar/beauty": "1.1.0-beta",
    "@google/genai": "^1.29.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "catalog:",
    "@vercel/speed-insights": "^2.0.0",
    "deepar": "^5.6.22",
    "firebase": "^11.10.0",
    "js-sha256": "^0.11.1",
    "livekit-client": "^2.17.2",
    "motion": "^12.23.24",
    "react-router-dom": "^7.17.0",
    "react-webcam": "^7.2.0",
    "react-youtube": "^10.1.0",
    "resend": "^6.16.0",
    "svga": "^2.1.1",
    "tencentcloud-webar": "^2.0.3",
    "three": "^0.185.1",
    "workbox-window": "^7.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "catalog:",
    "clsx": "catalog:",
    "date-fns": "^4.2.1",
    "emoji-picker-react": "^4.19.1",
    "lucide-react": "catalog:",
    "playwright": "1.49.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "^2.15.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.0.1"
  }
}
