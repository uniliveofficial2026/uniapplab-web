# Local stack placeholders — copy to local/.env and fill as needed.
# Generated secrets go to local/.generated/ (gitignored).

# Postgres
POSTGRES_USER=unilive
POSTGRES_PASSWORD=change-me
POSTGRES_DB=unilive_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://unilive:change-me@localhost:5432/unilive_dev

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=unilive
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_BUCKET=unilive-media

# LiveKit (dev only — use generated keys in local/.generated/livekit.env)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Studio / local API
STUDIO_PORT=8787
STUDIO_HOST=127.0.0.1
UNILIVE_PROJECT_ID=project_local

# Mailpit (optional)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
