yarn-error.log
testem.log
/typings

# ---------------------------------------------------------------------------
# Secrets / local env — NEVER commit or zip these
# Permanent local key file: Universal-Fixer/.env.local
# Provider secrets must NOT use VITE_ (browser-visible).
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.*
.env*.bak*
!.env.example
!.env.*.example
!.env.providers.example
!.env.meshy.local.example

# Meshy local secrets
.env.meshy.local

# System Files
.DS_Store
Thumbs.db
._*

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Vercel staging mirror (local deploy prep — never push)
.vercel/

# Capacitor native build artifacts (keep ios/ android project sources)
artifacts/instacollab/ios/App/Pods/
artifacts/instacollab/ios/App/build/
artifacts/instacollab/ios/build/
artifacts/instacollab/ios/DerivedData/
artifacts/instacollab/android/.gradle/
artifacts/instacollab/android/app/build/
artifacts/instacollab/android/build/
artifacts/instacollab/android/local.properties
artifacts/instacollab/android/.idea/
artifacts/instacollab/android/key.properties
artifacts/instacollab/android/keystore/
