# Permanent provider secrets for Universal-Fixer local workflows.
# Copy values into Universal-Fixer/.env.local (never commit that file).
#
# IMPORTANT:
# - These names must NEVER start with VITE_
# - VITE_ variables are exposed to the browser
# - You only need the Kling format your account supports

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
MESHY_API_KEY=
ELEVENLABS_API_KEY=
RUNWAY_API_KEY=

# Kling — use whichever format your Kling account supports
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# UniLive’s Asset Studio safety controls (local only)
ASSET_STUDIO_DRY_RUN=true
ASSET_STUDIO_MAX_PAID_CALLS=1
ASSET_STUDIO_AUTO_RETRY=false
ASSET_STUDIO_REQUIRE_APPROVAL=true
